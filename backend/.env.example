ENV=development
# In production the app refuses to start with a default SECRET_KEY or PLATFORM_ADMIN_PASSWORD — set real values below.
# Local (Windows): keep the database OUTSIDE OneDrive/Dropbox, e.g.
# DATABASE_URL=sqlite:///C:/Users/<you>/AppData/Local/BizOS/data/bizos.db
# Docker / server:
DATABASE_URL=postgresql+psycopg2://bizos:bizos@db:5432/bizos
SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# First platform-admin account (created only if none exists)
PLATFORM_ADMIN_EMAIL=admin@bizos.local
PLATFORM_ADMIN_PASSWORD=admin1234
ALLOW_PUBLIC_SIGNUP=false

# Files and backups (defaults: ./uploads and %LOCALAPPDATA%\BizOS\backups)
# UPLOAD_DIR=
# BACKUP_DIR=
BACKUP_KEEP=30
# Retention is tiered: every backup from the last N days, then one a week, then one a month.
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=8
BACKUP_MONTHLY_KEEP=12
# Encrypts backup files at rest (Fernet/AES). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset = backups are stored unencrypted (fine for local dev, not for real customer data).
BACKUP_ENCRYPTION_KEY=

# Optional: enables the Claude-powered assistant and reading supplier invoices from photos
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AUTOMATION_INTERVAL_MINUTES=15

# Email (password reset, invoices, morning summary). Without SMTP, emails are only saved in the admin "Emails" page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Error monitoring (optional): paste the DSN of a Sentry project
SENTRY_DSN=
